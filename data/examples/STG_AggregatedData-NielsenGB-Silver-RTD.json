{
    "domain": "NielsenGB",
    "entity": "STG_AggregatedData-NielsenGB-Silver-RTD",
    "layer": "Staging",
    "process_requested": "transformation",
    "market": "RTD",
    "partition": [
        "RTD"
    ],
    "dependencyInbound": [
        "AggregatedData-NielsenGB-Bronze-RTD",
        "STG_MarketDim-NielsenGB-Silver-RTD",
        "STG_PeriodDim-NielsenGB-Silver-RTD",
        "STG_ProductDim-NielsenGB-Silver-RTD"
    ],
    "dependencyOutbound": [],
    "D0_common_conf": {
        "use-case": "GDF",
        "prcs-name": "staging-process",
        "table_name": "STG_AggregatedData_RTD"
    },
    "D1_data_extract_process": {
        "type": "data_extract_process",
        "sourceList": [
            "source1",
            "source2",
            "source3",
            "source4"
        ],
        "source1": {
            "type": "bronze-zone",
            "storage_account_name": "dlsgdadev",
            "container": "bronze",
            "read-type": "delta-load",
            "file-format": "parquet",
            "delimiter": "",
            "path": "/nielsen/GB/RTD/",
            "fileName": "Client_GB_RTD_aggregated_data",
            "derived-key-process": {
                "T1": {
                    "process": "new-default",
                    "default-value": "RTD",
                    "colName": "Category_DB_name"
                }
            },
            "cols-alias-lookup": {
                "lookup_config_path": "config/nielsen/GB/CG_Indicators/",
                "lookup_config_filter": "cat_db='RTD' and to_be_included='Y'",
                "mandatory_columns": [
                    "market_id",
                    "product_id",
                    "period_id",
                    "Category_DB_name",
                    "input_file"
                ],
                "volume": "cg_indicators"
            },
            "volume": "rtd"
        },
        "source2": {
            "type": "staging-zone",
            "storage_account_name": "dlsgdadev",
            "container": "staging",
            "read-type": "delta-load",
            "file-format": "parquet",
            "delimiter": "",
            "path": "/staging/global/transactional/marketing/marketing/marketshare/nielsenGB/RTD/STG_MarketDim_RTD/",
            "fileName": "part-",
            "cols": [
                "Market_nk",
                "_Market_Desc_uid"
            ],
            "combine": {
                "type": "join",
                "base-table-key": [
                    "market_id"
                ],
                "source-table-key": [
                    "Market_nk"
                ],
                "join-type": "left"
            },
            "volume": "stg_marketdim_rtd"
        },
        "source3": {
            "type": "staging-zone",
            "storage_account_name": "dlsgdadev",
            "container": "staging",
            "read-type": "delta-load",
            "file-format": "parquet",
            "delimiter": "",
            "path": "/staging/global/transactional/marketing/marketing/marketshare/nielsenGB/RTD/STG_PeriodDim_RTD/",
            "fileName": "part-",
            "cols": [
                "Period_nk",
                "_Period_uid",
                "Period_Start_date",
                "Period_End_date",
                "NIQ_Periodicity_desc"
            ],
            "combine": {
                "type": "join",
                "base-table-key": [
                    "period_id"
                ],
                "source-table-key": [
                    "Period_nk"
                ],
                "join-type": "left"
            },
            "volume": "stg_perioddim_rtd"
        },
        "source4": {
            "type": "staging-zone",
            "storage_account_name": "dlsgdadev",
            "container": "staging",
            "read-type": "delta-load",
            "file-format": "parquet",
            "delimiter": "",
            "path": "/staging/global/transactional/marketing/marketing/marketshare/nielsenGB/RTD/STG_ProductDim_RTD/",
            "fileName": "part-",
            "cols": [
                "Product_nk",
                "_Product_uid",
                "Hierarchy_num",
                "Hierarchy_Level_num",
                "Hierarchy_Level_name"
            ],
            "combine": {
                "type": "join",
                "base-table-key": [
                    "product_id"
                ],
                "source-table-key": [
                    "Product_nk"
                ],
                "join-type": "inner"
            },
            "volume": "stg_productdim_rtd"
        }
    },
    "D2_data_transform_process": {
        "type": "data_transform_process",
        "transform-list": [
            "T1"
        ],
        "T1": {
            "type": "custom-sql-query",
            "def": {
                "interim-query": "select _Market_Desc_uid, market_id, _Product_uid, product_id, _Period_uid, Period_Start_date, Period_End_date, Category_DB_name, Average_Price_Per_Sales_Liter_loccur, 0 as Average_Items_Per_Store_num, Average_Store_num, Baseline_Sales_liter, Baseline_Sales_qty, Baseline_Sales_loccur, 0 as Numeric_Distribution_Total_TPR_num, 0 as Weighted_Distribution_Total_TPR_num, Number_of_Items_num, Numeric_Distribution_num, Numeric_Distribution_Reach_num, Numeric_Distribution_Any_Promo_num, 0 as Numeric_Distribution_Disp_wo_Feat_num, Numeric_Distribution_Feat_and_Disp_num, Numeric_Distribution_Feat_wo_Disp_num, Price_Any_Promo_Per_Liter_loccur, Average_Price_Per_Sales_Unit_loccur, Price_Any_Promo_Per_Unit_loccur, ROS_Reach_liter, ROS_liter, ROS_qty, ROS_Reach_qty, ROS_loccur, Sales_liter, Sales_Any_Promo_liter, 0 as Sales_Disp_wo_Feat_liter, Sales_Disp_wo_Feat_alt_liter, Sales_Feat_and_Disp_liter, Sales_Feat_wo_Disp_liter, 0 as Sales_Feat_wo_Disp_alt_liter, Sales_No_Promo_liter, Sales_Total_Disp_liter, 0 as Sales_Total_TPR_liter, Sales_qty, Sales_Any_Promo_qty, Sales_Disp_wo_Feat_qty, Sales_Feat_and_Disp_qty, Sales_No_Promo_qty, Sales_Total_Disp_qty, 0 as Sales_Total_TPR_qty, Sales_loccur, Sales_Any_Promo_loccur, 0 as Sales_Disp_wo_Feat_loccur, Sales_Disp_wo_Feat_alt_loccur, Sales_Feat_and_Disp_loccur, Sales_Feat_wo_Disp_loccur, 0 as Sales_Feat_wo_Disp_alt_loccur, 0 as Sales_Feat_wo_Disp_qty, Sales_No_Promo_loccur, Sales_Total_Disp_loccur, 0 as Sales_Total_TPR_loccur, Universe_Number_of_Stores_num, Weighted_Distribution_num, Weighted_Distribution_Reach_num, Weighted_Distribution_Any_Promo_num, 0 as Weighted_Distribution_Disp_wo_Feat_num, Weighted_Distribution_Feat_and_Disp_num, Weighted_Distribution_Feat_wo_Disp_num, 'GBP' as Local_Currency_code, Hierarchy_num, Hierarchy_Level_num, Hierarchy_Level_name, case when NIQ_Periodicity_desc = 'Weeks' then 7 else null end as elapsed_period, input_file, CURRENT_TIMESTAMP() as load_date, CURRENT_TIMESTAMP() as last_update from hash_df",
                "final-query": "select * from interm_df"
            }
        }
    },
