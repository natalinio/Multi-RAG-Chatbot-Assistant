        "T1": {
            "type": "custom-sql-query",
            "def": {
                "interim-query": "select _Product_uid, sum(Sales_loccur) as Sales_loccur, sum(Sales_qty) as Sales_qty, (select sum(Sales_loccur) from hash_df) as Total_Sales_loccur, (select sum(Sales_qty) from hash_df) as Total_Sales_qty, Category_DB_name, _Product_MS_uid, Brand_Division_desc, Sub_Brand_Division_desc, Colour_desc, Sweetness_of_Alcoholic_Beverage_desc, Container_Size_desc from hash_df where _Source_Product_name is null group by _Product_uid, Category_DB_name, _Product_MS_uid, Brand_Division_desc, Sub_Brand_Division_desc, Colour_desc, Sweetness_of_Alcoholic_Beverage_desc, Container_Size_desc",
                "final-query": "select _Product_uid as Source_Product_uid, _Product_uid as Code, _Product_MS_uid as Source_Product_MS_uid, concat(Sub_Brand_Division_desc,' ',case when Colour_desc is null then '' else Colour_desc end,' ',case when Sweetness_of_Alcoholic_Beverage_desc is null then '' else Sweetness_of_Alcoholic_Beverage_desc end,' ',case when Container_Size_desc is null then '' else Container_Size_desc end) as Source_Product_name, Container_Size_desc as Source_Bottle_Size_desc, Category_DB_name as Source_Category_desc, 'GB' as Source_Country_desc, null as Source_Owner_desc, Brand_Division_desc as Source_Brand_desc, null as Source_Barcode_code, Sales_qty as Source_Sales_qty, Sales_loccur as Source_Sales_amt, (Sales_qty/Total_Sales_qty)*100 as Source_Sales_qty_share, (Sales_loccur/Total_Sales_loccur)*100 as Source_Sales_amt_share, 'Nielsen' as Source_System_name from interm_df"
            }
        }
    },
