        "US",
        "CategoryA"
    ],
    "dependencyInbound": [],
    "dependencyOutbound": [
        "EntityName-DomainA-Silver-US"
    ],
    "I0_common_conf": {
        "use-case": "generic-use-case",
        "prcs-name": "bronze-ingestion-process",
        "table_name": "entity_table_name"
    },
    "I1_data_extract_process": {
        "type": "data_read_process",
        "source": {
            "type": "asql",
            "path": "schema.source_table",
